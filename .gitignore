# WordPress Plugin Bundle - .gitignore

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Bundled plugins directory - plugins are now downloaded from GitHub Releases
bundled-plugins/

# Generated ZIP files (created by build script)
plugin-zips/

# Build script output
*.zip
*.tar.gz

# Keep these folders (tracked in git):
# - admin/
# - assets/
# - includes/
# - wp-plugin-bundle.php
# - README.md
# - create-plugin-zips.ps1 (build script)
